# Variáveis de ambiente da API (Django). Modelo SEM segredos reais.
#
# Em produção (Render) elas são definidas pelo render.yaml e pelo painel do Render:
# veja docs/05-deploy-passo-a-passo.md. Localmente, o Django NÃO lê este arquivo
# sozinho: copie para .env e carregue no terminal antes de rodar
#   (bash)        set -a; source .env; set +a
#   (PowerShell)  Get-Content .env | ? { $_ -match '^[A-Z]' } | % { $k,$v = $_ -split '=',2; Set-Item env:$k $v }
# Sem nenhuma variável, a API roda em modo de desenvolvimento (DEBUG, SQLite).
#
# Legenda: [obrigatória em produção] · [render.yaml] = já definida no Blueprint ·
#          [painel] = você preenche no Render na criação · demais = opcional, com padrão.

# ── Núcleo ────────────────────────────────────────────────────────────────────
# Modo de desenvolvimento. Em produção: false. [render.yaml]
DJANGO_DEBUG=true
# Chave criptográfica (assina tokens e URLs). [obrigatória em produção] [render.yaml: gerada pelo Render]
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Nunca reutilize a chave antiga do histórico do git: veja docs/05 (seção SECRET_KEY).
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-50-caracteres
# Domínios aceitos pela API, separados por vírgula. No Render o domínio do serviço
# entra sozinho (RENDER_EXTERNAL_HOSTNAME); adicione aqui só um domínio próprio.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Caminho do admin do Django, difícil de adivinhar e terminando com "/". [painel]
DJANGO_ADMIN_URL=painel-interno-troque-isto/

# ── Banco de dados ────────────────────────────────────────────────────────────
# URL do Postgres. Sem ela, usa SQLite (backend/db.sqlite3). [render.yaml: vem do banco agenda-db]
DATABASE_URL=postgres://agenda:senha@localhost:5432/agenda
# Pool de conexões do psycopg (recomendado em produção). [render.yaml]
DB_POOL=true
DB_POOL_MIN=1
DB_POOL_MAX=4
# Tempo de vida das conexões sem pool (segundos). Ignorado quando DB_POOL=true.
DB_CONN_MAX_AGE=0

# ── Navegador e segurança ─────────────────────────────────────────────────────
# Endereço do front (Static Site), sem barra no fim. [painel]
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origens confiáveis para formulários com CSRF (o admin). Use o endereço da própria API. [painel]
CSRF_TRUSTED_ORIGINS=https://agenda-api.onrender.com
# Quantos proxies reescrevem o X-Forwarded-For antes da API (Render = 1). [render.yaml]
NUM_PROXIES=1
# Header com o IP real do cliente, se o proxy usar um específico (ex.: CF-Connecting-IP). Vazio = X-Forwarded-For.
IP_HEADER=
# Redireciona HTTP para HTTPS (só com DEBUG=false). Deixe true em produção.
SECURE_SSL_REDIRECT=true
# Duração do HSTS em segundos (só com DEBUG=false). Padrão: 1 ano.
SECURE_HSTS_SECONDS=31536000

# ── Limites de requisições (rate limit) ───────────────────────────────────────
LIMITE_LOGIN=10/min
LIMITE_REFRESH=30/min
LIMITE_REGISTRO=5/hour
LIMITE_RESERVA_PUBLICA=30/hour
LIMITE_PUBLICO=120/min
LIMITE_PAINEL=600/min

# ── Regras de agendamento ─────────────────────────────────────────────────────
# Quantos dias à frente o cliente pode reservar.
AGENDAMENTO_MAX_DIAS_ANTECEDENCIA=180

# ── Mídia (fotos e vídeos) ────────────────────────────────────────────────────
# 'cloudinary' em produção. 'local' (disco) só para desenvolvimento e simulação;
# a API se recusa a subir com 'local' no Render.
MIDIA_PROVEDOR=cloudinary
# Credenciais do Cloudinary: painel do Cloudinary → Settings → API Keys →
# "API environment variable". Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
# [obrigatória em produção] [painel: na API e no cron]
CLOUDINARY_URL=cloudinary://123456789012345:troque-o-segredo@seu-cloud-name
# Pasta raiz dos arquivos no provedor.
MIDIA_PASTA_RAIZ=agenda
# Alerta do comando verificar_uso_midia (créditos do mês; o plano Free tem 25).
MIDIA_ALERTA_CREDITOS=15
# Limites por arquivo (bytes): imagem 10 MB, vídeo 100 MB.
MIDIA_MAX_BYTES_IMAGEM=10485760
MIDIA_MAX_BYTES_VIDEO=104857600
# Limites por agendamento e por serviço.
MIDIA_MAX_ARQUIVOS_POR_AGENDAMENTO=15
MIDIA_MAX_BYTES_POR_AGENDAMENTO=262144000
MIDIA_MAX_ARQUIVOS_POR_SERVICO=10
MIDIA_MAX_BYTES_POR_SERVICO=157286400
MIDIA_MAX_YOUTUBE_POR_SERVICO=3
# Só com MIDIA_PROVEDOR=local: pasta dos arquivos e endereço público da API.
MIDIA_LOCAL_DIR=./midia-local
MIDIA_LOCAL_URL_BASE=http://localhost:8000

# ── Logs ──────────────────────────────────────────────────────────────────────
# 'json' em produção (uma linha por requisição); 'texto' no desenvolvimento. [render.yaml]
LOG_FORMATO=json
LOG_LEVEL=INFO

# ── Servidor (gunicorn.conf.py) ───────────────────────────────────────────────
# Porta: o Render define sozinho.
PORT=8000
# Processos e threads do gunicorn. Mantenha 1 processo enquanto o cache e o rate
# limit forem em memória (ver docs/06, "subir de plano").
WEB_CONCURRENCY=1
GUNICORN_THREADS=4

# ── Definidas pelo próprio Render (não preencha) ──────────────────────────────
# RENDER=true                          → indica que está no Render
# RENDER_EXTERNAL_HOSTNAME=agenda-api.onrender.com → entra no ALLOWED_HOSTS
# PYTHON_VERSION=3.13.5                → versão do Python no build [render.yaml]
